---
import '../styles/global.css';
import { renderPage,site,schedule,notices,materials } from '../lib/content';
import { renderNotices,escapeHtml } from '../lib/calendar.mjs';
const {title,slug}=Astro.props;
const runtime=JSON.stringify({schedule,notices}).replace(/</g,'\\u003c');
const script=['programacao','como-chegar','estudo'].includes(slug)?`/scripts/${slug}.js`:null;
const fullAddress=`${site.address} — ${site.district} — ${site.city}/${site.state} — CEP ${site.postalCode}`;
---
<!doctype html>
<html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | CECOP</title><meta name="description" content="Conheça o CECOP, consulte a programação de atendimentos gratuitos e saiba como chegar à casa em Curitiba."/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Merriweather:wght@400;700;900&family=Material+Symbols+Outlined&display=swap" rel="stylesheet"/></head>
<body class="bg-surface font-body text-on-surface antialiased" data-address={fullAddress}>
<a href="#conteudo" class="skip-link">Pular para o conteúdo</a>
<Fragment set:html={renderPage('header')}/>
<div id="conteudo" tabindex="-1"></div>
<div data-notices class="max-w-[1200px] mx-auto px-6 empty:hidden pt-28"><Fragment set:html={renderNotices(notices)}/></div>
<slot/>
{slug==='estudo'&&materials.items.length>0&&<section class="max-w-[1200px] mx-auto p-6"><h2 class="text-2xl font-bold text-primary mb-5">Materiais para download</h2>{materials.items.map(m=><article class="p-5 rounded-lg border mb-4"><h3>{m.title}</h3><p>{m.description}</p><a href={m.file} class="underline text-primary" download>Baixar material</a></article>)}</section>}
<Fragment set:html={renderPage('footer')}/>
<script id="cecop-content" type="application/json" set:html={runtime}/>
{script&&<script is:inline src={script} defer></script>}
<script>
import {renderCalendar,renderNotices} from '../lib/calendar.mjs';
const data=JSON.parse(document.getElementById('cecop-content')!.textContent!);
function refresh(){document.querySelectorAll('[data-calendar]').forEach(el=>{const wrapper=document.createElement('div');wrapper.innerHTML=renderCalendar(data.schedule);el.innerHTML=wrapper.firstElementChild!.innerHTML;});document.querySelectorAll('[data-notices]').forEach(el=>{el.innerHTML=renderNotices(data.notices);});}
refresh();setInterval(refresh,60000);
const button=document.querySelector<HTMLButtonElement>('[data-menu-toggle]');const menu=document.getElementById('mobile-nav');
function closeMenu(){if(menu)menu.hidden=true;button?.setAttribute('aria-expanded','false');button?.setAttribute('aria-label','Abrir menu de navegação');}
button?.addEventListener('click',()=>{if(!menu)return;menu.hidden=!menu.hidden;button.setAttribute('aria-expanded',String(!menu.hidden));button.setAttribute('aria-label',menu.hidden?'Abrir menu de navegação':'Fechar menu de navegação');});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu&&!menu.hidden){closeMenu();button?.focus();}});
document.querySelectorAll('header a[href]').forEach(a=>{if(new URL((a as HTMLAnchorElement).href).pathname===location.pathname)a.setAttribute('aria-current','page');});
</script>
</body></html>
