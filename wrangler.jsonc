{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cecop",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "SITE_ORIGIN": "https://cecop.r-augusto.workers.dev"
  },
  "previews": {
    "vars": {
      "SITE_ORIGIN": "https://preview.invalid"
    }
  }
}
